{
  "name": "portfolio-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "export": "node scripts/export.js",
    "import": "node scripts/import.js",
    "media-migrate": "node scripts/media-migrate.js",
    "test": "node --test test/*.test.js",
    "verify:production": "node scripts/verify-production.js",
    "bootstrap-admin:interactive": "node scripts/bootstrap-admin-interactive.js",
    "deploy:check": "node scripts/deployment-check.js",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
