# Local development defaults. Replace every production value in Render/GitHub secrets.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-48-random-bytes
SITE_URL=http://localhost:8787
ALLOWED_ORIGINS=
TRUST_PROXY=false
DB_POOL_MAX=3
AUTO_MIGRATE=true
OWNER_EMAIL=owner@example.com
WHATSAPP_NUMBER=2348000000000
SESSION_HOURS=12

# Production media storage: Cloudinary or Dbrij S3-compatible Storage. Local is for development only.
# Cloudinary signed uploads (recommended for portfolio images):
# STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=./data/media
DBRIJ_S3_ENDPOINT=https://s3.dbrij.com
DBRIJ_S3_REGION=auto
DBRIJ_BUCKET=portfolio-media
DBRIJ_KEY_ID=
DBRIJ_KEY_SECRET=
# Format: https://files.dbrij.com/<MEDIA_BUCKET_ID> (the bucket must be public)
DBRIJ_MEDIA_PUBLIC_BASE=
MAX_UPLOAD_MB=8

# Optional Cloudflare Turnstile. It does not require activating Cloudflare R2.
# Configure BOTH keys or leave BOTH empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production hardening (admin sign-in is email + password; no two-factor authentication).
ENFORCE_SITE_HOST=false
SITE_HOST_ALLOWLIST=

# Email remains in log mode until a sender is configured; Brevo Free advertises no-card signup.
EMAIL_PROVIDER=log
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Portfolio Website
AI_PROVIDER=rules
RETENTION_DAYS=400
