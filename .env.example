# Local development defaults. Replace every production value in Render/GitHub secrets.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-48-random-bytes
SITE_URL=http://localhost:8787
ALLOWED_ORIGINS=
TRUST_PROXY=false
DB_POOL_MAX=3
AUTO_MIGRATE=true
OWNER_EMAIL=owner@example.com
WHATSAPP_NUMBER=2348000000000
SESSION_HOURS=12

# LinkedIn personal-profile auto-publishing (OAuth credentials stay server-side).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the Redirect URL registered in the LinkedIn Developer Portal.
# Defaults to SITE_URL + /api/integrations/linkedin/callback.
LINKEDIN_REDIRECT_URI=
# Latest LinkedIn Marketing API version as of November 2026.
LINKEDIN_VERSION=202611

# Meta OAuth is shared by Facebook Pages and linked Instagram Professional accounts.
META_GRAPH_VERSION=v27.0
META_APP_ID=
META_APP_SECRET=
# Meta Facebook Login for Business / Unified Login configuration ID (optional for legacy apps).
META_LOGIN_CONFIG_ID=
# Defaults: SITE_URL + /api/integrations/facebook/callback and /api/integrations/instagram/callback.
META_FACEBOOK_REDIRECT_URI=
META_INSTAGRAM_REDIRECT_URI=

# X OAuth 2.0 (Authorization Code + PKCE).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Defaults to SITE_URL + /api/integrations/x/callback.
X_REDIRECT_URI=

# TikTok Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Defaults to SITE_URL + /api/integrations/tiktok/callback.
TIKTOK_REDIRECT_URI=

# Google Identity Services web client ID for admin sign-in.
GOOGLE_CLIENT_ID=

# Production media storage: Cloudinary or Dbrij S3-compatible Storage. Local is for development only.
# Cloudinary signed uploads (recommended for portfolio images):
# STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=./data/media
DBRIJ_S3_ENDPOINT=https://s3.dbrij.com
DBRIJ_S3_REGION=auto
DBRIJ_BUCKET=portfolio-media
DBRIJ_KEY_ID=
DBRIJ_KEY_SECRET=
# Format: https://files.dbrij.com/<MEDIA_BUCKET_ID> (the bucket must be public)
DBRIJ_MEDIA_PUBLIC_BASE=
MAX_UPLOAD_MB=8

# Optional Cloudflare Turnstile. It does not require activating Cloudflare R2.
# Configure BOTH keys or leave BOTH empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production hardening (admin sign-in is email + password; no two-factor authentication).
ENFORCE_SITE_HOST=false
SITE_HOST_ALLOWLIST=

# Email remains in log mode until a sender is configured; Brevo Free advertises no-card signup.
EMAIL_PROVIDER=log
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Portfolio Website
AI_PROVIDER=rules
RETENTION_DAYS=400
